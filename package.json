{
  "name": "reference-components",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:states && vite",
    "build": "npm run generate:states && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "npm run generate:states && playwright test",
    "test": "vitest run && npm run generate:states && playwright test",
    "typecheck": "tsc --noEmit",
    "generate:states": "vite-node src/partials/components/DateField/DateField.generate.ts && vite-node src/partials/components/FileUpload/FileUpload.generate.ts && vite-node src/partials/components/DateTimeField/DateTimeField.generate.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.6.0",
    "axe-playwright": "^2.2.2",
    "jsdom": "^29.0.1",
    "postcss-nesting": "^13.0.1",
    "typescript": "^6.0.2",
    "vite": "^6.2.6",
    "vite-node": "^6.0.0",
    "vite-plugin-handlebars": "^2.0.0",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "supports-css": "^0.3.0"
  }
}
